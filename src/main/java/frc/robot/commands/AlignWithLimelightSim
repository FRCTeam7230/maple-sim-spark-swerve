public class AlignWithLimelightSim {
    //Find the nearest apriltag (we're here to test auto, not limelight)
    //Move the robot to the left or right reef depending on the command
    //Profit?
    AprilTagFieldLayout aprilTagInField = VisionConstants.aprilTagLayout;
    List<AprilTag> aprilTags = aprilTagInField.getTags();
    Pose2d robotPosition;
    public AlignWithLimelightSim(Pose2d robot){
        robotPosition = robot;
    }
    public int findNearestAprilTag(){
        int closestAprilTagIndex = 0;
        double closestDistance = 0; //I know there are ways to not have to declare this, but i'm too lazy
        //Pose3d currentAprilTagPosition = aprilTags.get(closestAprilTagIndex).pose;
        for (AprilTag tag : aprilTags){
            Pose3d pos = tag.pose;
            //double dist = Math.sqrt(Math.pow(pos.getX()-currentAprilTagPosition.getX(),2)+Math.pow(pos.getY()-currentAprilTagPosition.getY(),2));
            double dist = Math.sqrt(Math.pow(pos.getX()-robotPosition.getX(),2)+Math.pow(pos.getY()-robotPosition.getY(),2));
            if (dist < closestDistance){
                closestAprilTagIndex = tag.ID;
                closestDistance = dist;
                //currentAprilTagPosition = aprilTags.get(closestAprilTagIndex).pose;//
            }
        }
        return closestAprilTagIndex;
    }
    public PathPlannerPath followPathToReef(AprilTag tag){
        // Create a list of waypoints from poses. Each pose represents one waypoint.
        // The rotation component of the pose should be the direction of travel. Do not use holonomic rotation.
        List<Waypoint> waypoints = PathPlannerPath.waypointsFromPoses(
                //new Pose2d(tag.pose.getX(), tag.pose.getY(), Rotation2d.fromDegrees(0))

        );

        PathConstraints constraints = new PathConstraints(3.0, 3.0, 2 * Math.PI, 4 * Math.PI); // The constraints for this path.
        // PathConstraints constraints = PathConstraints.unlimitedConstraints(12.0); // You can also use unlimited constraints, only limited by motor torque and nominal battery voltage

        // Create the path using the waypoints created above
        PathPlannerPath path = new PathPlannerPath(
                waypoints,
                constraints,
                null, // The ideal starting state, this is only relevant for pre-planned paths, so can be null for on-the-fly paths.
                new GoalEndState(0.0, tag.pose.getRotation().toRotation2d()) // Goal end state. You can set a holonomic rotation here. If using a differential drivetrain, the rotation will have no effect.
        );

        // Prevent the path from being flipped if the coordinates are already correct
        path.preventFlipping = true;

        return path;
    }
    public PathPlannerPath makePathToNearestTag(){
        AprilTag findNearestAprilTag();
    }
}
