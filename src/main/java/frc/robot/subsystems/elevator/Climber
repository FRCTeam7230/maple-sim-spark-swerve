public class Climber extends SubsystemBase implements AutoCloseable {
  // This gearbox represents a gearbox containing 4 Vex 775pro motors.
  private final DCMotor m_elevatorGearbox = DCMotor.getNEO(2);

  // Simulation classes help us simulate what's going on, including gravity.
  
  private final SingleJointedArmSim m_climberSim =
  new SingleJointedArmSim(
      m_elevatorGearbox,
      Constants.ElevatorSimConstants.kElevatorGearing,
      Constants.ElevatorSimConstants.kCarriageMass,
      Constants.ElevatorSimConstants.kElevatorDrumRadius,
      Constants.ElevatorSimConstants.kMinElevatorHeightMeters,
      Constants.ElevatorSimConstants.kMaxElevatorHeightMeters,
      true,
      0,
      0.005,
      0.0);
      //private final SparkMax                  m_motor      = new SparkMax(1, MotorType.kBrushless);4 
      private final PWMSparkMax m_motor = new PWMSparkMax(Constants.ElevatorSimConstants.kMotorPort);
      private final EncoderSim m_encoderSim = new EncoderSim(m_encoder);
  private final SparkClosedLoopController m_controller = m_motor.getClosedLoopController();
  private final RelativeEncoder           m_encoder    = m_motor.getEncoder();
  private final PWMSim                    m_motorSim = new PWMSim(m_motor);

    private final Encoder m_climbEncoder =
      new Encoder(Constants.ElevatorSimConstants.kEncoderAChannel+2, Constants.ElevatorSimConstants.kEncoderBChannel+2);

  // Create a Mechanism2d visualization of the elevator
  //private final Mechanism2d m_mech2d =
    //  new Mechanism2d(Units.inchesToMeters(10), Units.inchesToMeters(51));


  private final Mechanism2d m_mechArm = 
      new Mechanism2d(Units.inchesToMeters(51), Units.inchesToMeters(10));
  private final MechanismRoot2d m_climberArmRoot2d = m_mechArm.getRoot("Arm Root", Units.inchesToMeters(10), Units.inchesToMeters(51));
  private final MechanismLigament2d m_climberArm2d = m_climberArmRoot2d.append(
        new MechanismLigament2d("Arm", 1, 20)//Change the angle to the simulation's updated angle/
      );

    public Climber() {
        m_climbEncoder.setDistancePerPulse(Constants.ElevatorSimConstants.kElevatorEncoderDistPerPulse);

        // Publish Mechanism2d to SmartDashboard
        // To view the Elevator visualization, select Network Tables -> SmartDashboard -> Elevator Sim
       SmartDashboard.putData("Climber Sim Test", m_mechArm);
//SmartDashboard.putData("Elevator Sim", m_);
    }

    @Override
    public void periodic() {
        // In this method, we update our simulation of what our elevator is doing
        // First, we set our "inputs" (voltages)
        m_climberSim.setInput(m_motorSim.getSpeed() * RobotController.getBatteryVoltage());

        // Next, we update it. The standard loop time is 20ms.
        m_climberSim.update(0.020);

        // Finally, we set our simulated encoder's readings and simulated battery voltage
        m_climberSim.setDistance(m_climberSim.getPositionMeters());
        // SimBattery estimates loaded battery voltages
        RoboRioSim.setVInVoltage(
            BatterySim.calculateDefaultBatteryLoadedVoltage(m_climberSim.getCurrentDrawAmps()));

        updateTelemetry();
    }

  /**
   * Set the goal of the elevator
   *
   * @param goal Goal in meters
   * @return {@link edu.wpi.first.wpilibj2.command.Command}
   */
  public Command setGoal(double goal)
  {
    return run(() -> reachGoal(goal));
  }

  /** Advance the simulation. */
  public void simulationPeriodic() {

  }

  /**
   * Run control loop to reach and maintain goal.
   *
   * @param goal the position to maintain
   */
  /** Stop the control loop and motor output. */
  public void stop() {
   // m_motor.set(0.0);
  }

  /** Reset Exponential profile to begin from current position on enable. */
  public void reset() {
  }

  /** Update telemetry, including the mechanism visualization. */
  public void updateTelemetry() {
    // Update elevator visualization with position
    m_climberArm2d.setAngle(m_encoder.getAngle());//We need an encoder here.
    m_climberArm2d.setLength(m_encoder.getLength());//We need an encoder here.
  }

  @Override
  public void close() {
    m_encoder.close();
    m_motor.close();
    m_mech2d.close();
  }
}
